/* 全局样式：按参考图还原 —— 深蓝黑底 + 青柠绿主色 */
@import './styles/tokens.wxss';
@import './styles/common.wxss';

page {
  background: var(--shb-bg-page);
  color: var(--shb-text-primary);
  font-size: var(--shb-fs-base);
  font-weight: var(--shb-fw-regular);
}

button {
  padding: 0;
  margin: 0;
  background: transparent;
  line-height: inherit;
  font-size: inherit;
  border-radius: 0;
}
button::after { border: none; }
