@import '../../styles/tokens.wxss';

/* 宿主节点块级化 */
:host {
  display: block;
}

.chat-bubble {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.chat-bubble--self {
  align-items: flex-end;
}

.chat-bubble__meta {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-bottom: 8rpx;
  padding: 0 8rpx;
}

.chat-bubble__name {
  font-size: var(--shb-fs-xs);
  font-weight: var(--shb-fw-medium);
  color: var(--shb-text-secondary);
}

.chat-bubble__time {
  font-size: var(--shb-fs-xs);
  font-weight: var(--shb-fw-regular);
  color: var(--shb-text-tertiary);
}

/* 他人气泡：浮层底圆角；本人气泡：青柠绿底深字 */
.chat-bubble__content {
  max-width: 76%;
  padding: 18rpx 26rpx;
  font-size: var(--shb-fs-base);
  line-height: 1.5;
  color: var(--shb-text-primary);
  background: var(--shb-bg-elev);
  border-radius: 28rpx;
  border-bottom-left-radius: 8rpx;
  word-break: break-all;
}

.chat-bubble--self .chat-bubble__content {
  background: var(--shb-color-primary);
  color: var(--shb-text-inverse);
  font-weight: var(--shb-fw-medium);
  border-bottom-left-radius: 28rpx;
  border-bottom-right-radius: 8rpx;
}
