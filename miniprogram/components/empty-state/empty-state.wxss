@import '../../styles/tokens.wxss';
@import '../../styles/common.wxss';

/* 宿主节点块级化 */
:host {
  display: block;
}

.empty-state {
  margin: 36rpx;
  padding: 80rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: var(--shb-bg-card);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  border-radius: var(--shb-radius-xl);
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.4);
}

/* 电竞雷达脉冲微标 */
.empty-state__mark {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 24rpx;
  border-radius: 50%;
  background: rgba(192, 232, 99, 0.08);
  border: 2rpx solid rgba(192, 232, 99, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  font-weight: 800;
  color: var(--shb-color-primary);
  box-shadow: 0 0 24rpx rgba(192, 232, 99, 0.15);
}

.empty-state__mark::after {
  content: '⚡';
  font-size: 44rpx;
}

.empty-state__title {
  font-size: var(--shb-fs-lg);
  font-weight: var(--shb-fw-bold);
  color: #ffffff;
  letter-spacing: 1rpx;
}

.empty-state__desc {
  margin-top: 12rpx;
  font-size: var(--shb-fs-sm);
  color: var(--shb-text-secondary);
  text-align: center;
  line-height: 1.5;
}

.empty-state__btn {
  margin-top: 36rpx;
  height: 76rpx;
  display: flex;
  align-items: center;
  padding: 0 52rpx;
  border-radius: var(--shb-radius-full);
  background: var(--shb-color-primary);
  color: var(--shb-text-inverse);
  font-size: var(--shb-fs-base);
  font-weight: var(--shb-fw-bold);
  letter-spacing: 2rpx;
  box-shadow: 0 6rpx 20rpx rgba(192, 232, 99, 0.3);
  transition: all 0.15s ease;
}

.empty-state__btn--hover {
  background: var(--shb-color-primary-pressed);
  transform: scale(0.96);
}

