<!-- ============================================================
  room-card 房间卡片（参考图样式）
  左封面 | 标题(游戏·模式) + meta(时间·备注) | 右计分 + 加入/状态
  properties:
    roomId / game / mode / startTimeLabel / memberCount / maxPlayers
    status / remark / roleText（我的房间角色标，空不展示）
    isMine（本人已在房中：右侧胶囊显示「回到房间」而非「加入」）
  events:
    tap  detail: { roomId }
============================================================ -->
<view
  class="room-card esports-card press-scale {{isFull ? 'room-card--full' : ''}}"
  hover-class="room-card--hover"
  bindtap="onTap"
>
  <!-- 封面海报 -->
  <view class="room-card__cover">
    <game-cover game="{{game}}" />
  </view>

  <!-- 中间主体信息 -->
  <view class="room-card__main">
    <view class="room-card__title-row">
      <text class="room-card__title">{{game}}</text>
      <text wx:if="{{mode}}" class="room-card__mode">· {{mode}}</text>
      <text wx:if="{{roleText === '房主'}}" class="room-card__role">👑 房主</text>
    </view>

    <view class="room-card__meta">
      <text class="room-card__time">开打时间：{{startTimeLabel}}</text>
    </view>

    <view class="room-card__sub-row">
      <view class="room-card__players">
        <text class="room-card__player-icon">👥</text>
        <text class="room-card__count num">{{memberCount}}<text class="room-card__count-max">/{{maxPlayers}}</text></text>
      </view>
      <text wx:if="{{remark}}" class="room-card__remark text-ellipsis">{{remark}}</text>
    </view>
  </view>

  <!-- 右侧状态/行动胶囊（对齐设计图：招募中/进行中等青柠绿胶囊） -->
  <view class="room-card__side">
    <text class="room-card__dots">···</text>
    <!-- 本人已在房中：回房入口 -->
    <view wx:if="{{isMine && status !== 'dissolved'}}" class="room-card__join room-card__join--mine">回到房间</view>
    <!-- 招募中：鲜亮青柠绿「招募中」胶囊 -->
    <view wx:elif="{{status === 'recruiting' && !isFull}}" class="room-card__join">招募中</view>
    <!-- 等待中 / 准备就绪：亮黄色胶囊 -->
    <view wx:elif="{{status === 'pending'}}" class="room-card__join room-card__join--pending">等待开始</view>
    <!-- 进行中：浅绿胶囊 -->
    <view wx:elif="{{status === 'ready'}}" class="room-card__join room-card__join--ready">进行中</view>
    <!-- 已满员：暗底胶囊 -->
    <view wx:elif="{{isFull}}" class="room-card__join room-card__join--full">已满员</view>
    <view wx:else class="tagdot {{status === 'dissolved' ? 'tagdot--gray' : ''}}">{{statusText}}</view>
  </view>
</view>

