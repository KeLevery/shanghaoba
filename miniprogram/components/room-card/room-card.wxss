@import '../../styles/tokens.wxss';
@import '../../styles/common.wxss';

/* 宿主节点块级化，保证列表内占满一行 */
:host {
  display: block;
}

.room-card {
  display: flex;
  align-items: center;
  gap: 22rpx;
  background: var(--shb-bg-card);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: var(--shb-radius-lg);
  padding: 24rpx;
  position: relative;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.35);
  margin-bottom: 20rpx;
}

.room-card--hover {
  background: var(--shb-bg-elev);
  border-color: rgba(192, 232, 99, 0.2);
}

.room-card--full {
  opacity: 0.75;
}

.room-card__cover {
  width: 140rpx;
  height: 140rpx;
  border-radius: var(--shb-radius-md);
  overflow: hidden;
  flex-shrink: 0;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.4);
}

.room-card__main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.room-card__title-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.room-card__title {
  font-size: var(--shb-fs-base);
  font-weight: var(--shb-fw-bold);
  color: var(--shb-text-primary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  flex-shrink: 1;
}

.room-card__mode {
  font-size: var(--shb-fs-sm);
  font-weight: var(--shb-fw-medium);
  color: var(--shb-text-secondary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  flex-shrink: 1;
}

.room-card__role {
  flex-shrink: 0;
  font-size: var(--shb-fs-xs);
  font-weight: var(--shb-fw-bold);
  color: #ffd15c;
  background: rgba(255, 178, 36, 0.12);
  border: 1rpx solid rgba(255, 178, 36, 0.4);
  padding: 2rpx 12rpx;
  border-radius: var(--shb-radius-full);
}

.room-card__meta {
  font-size: var(--shb-fs-sm);
  color: var(--shb-text-secondary);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.room-card__time {
  color: #c5ced8;
  font-weight: var(--shb-fw-medium);
}

.room-card__sub-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  font-size: var(--shb-fs-xs);
  color: var(--shb-text-tertiary);
}

.room-card__players {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  background: rgba(255, 255, 255, 0.04);
  padding: 2rpx 10rpx;
  border-radius: var(--shb-radius-sm);
}

.room-card__player-icon {
  font-size: 20rpx;
}

.room-card__count {
  font-size: var(--shb-fs-sm);
  color: #ffffff;
  font-weight: var(--shb-fw-bold);
}

.room-card__count-max {
  font-size: var(--shb-fs-xs);
  color: var(--shb-text-tertiary);
  font-weight: var(--shb-fw-regular);
}

.room-card__remark {
  flex: 1;
  min-width: 0;
  color: var(--shb-text-tertiary);
}

.room-card__side {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20rpx;
  flex-shrink: 0;
  align-self: stretch;
}

.room-card__dots {
  color: var(--shb-text-tertiary);
  font-size: 28rpx;
  line-height: 1;
  letter-spacing: 2rpx;
}

/* 加入胶囊：青柠绿填充深字，带微光阴影 */
.room-card__join {
  height: 56rpx;
  display: flex;
  align-items: center;
  padding: 0 32rpx;
  border-radius: var(--shb-radius-full);
  background: var(--shb-color-primary);
  color: var(--shb-text-inverse);
  font-size: var(--shb-fs-sm);
  font-weight: var(--shb-fw-bold);
  letter-spacing: 2rpx;
  box-shadow: 0 4rpx 16rpx rgba(192, 232, 99, 0.25);
  transition: all 0.15s ease;
}

.room-card__join--mine {
  background: rgba(192, 232, 99, 0.15);
  border: 1rpx solid var(--shb-color-primary);
  color: var(--shb-color-primary);
  box-shadow: none;
}

.room-card__join--full {
  background: var(--shb-bg-chip);
  border: 1rpx solid rgba(255, 255, 255, 0.05);
  color: var(--shb-text-tertiary);
  box-shadow: none;
}

