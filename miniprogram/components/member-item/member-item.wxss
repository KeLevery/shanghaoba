@import '../../styles/tokens.wxss';

/* 宿主节点块级化 */
:host {
  display: block;
}

.member {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
}

/* 圆形头像容器 */
.member__ava {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  background: var(--shb-bg-elev);
  color: #cfd6de;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: var(--shb-fw-bold);
  flex-shrink: 0;
  position: relative;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.3);
  border: 2rpx solid rgba(255, 255, 255, 0.1);
}

.member__ava--on {
  border-color: var(--shb-color-primary);
  box-shadow: 0 0 16rpx rgba(192, 232, 99, 0.3);
}

.member__ava-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.member__ava-dot {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: var(--shb-color-primary);
  border: 3rpx solid var(--shb-bg-card);
}

.member__info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.member__name-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.member__name-text {
  font-size: var(--shb-fs-base);
  font-weight: var(--shb-fw-medium);
  color: var(--shb-text-primary);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.member__crown {
  font-size: 28rpx;
  filter: drop-shadow(0 2rpx 4rpx rgba(255, 200, 0, 0.4));
}

.member__host-desc {
  font-size: var(--shb-fs-xs);
  color: #d4a347;
  letter-spacing: 1rpx;
}

/* 右侧准备状态徽章 */
.member__status {
  flex-shrink: 0;
}

.member__badge {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 18rpx;
  border-radius: var(--shb-radius-full);
  font-size: var(--shb-fs-xs);
  font-weight: var(--shb-fw-medium);
}

.member__badge-icon {
  font-size: 22rpx;
  font-weight: bold;
}

.member__badge--ready {
  background: rgba(192, 232, 99, 0.14);
  border: 1rpx solid rgba(192, 232, 99, 0.4);
  color: var(--shb-color-primary);
  box-shadow: 0 0 12rpx rgba(192, 232, 99, 0.15);
}

.member__badge--wait {
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  color: var(--shb-text-tertiary);
}

/* 房主踢人按键 */
.member__kick {
  flex-shrink: 0;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: rgba(255, 92, 108, 0.1);
  border: 1rpx solid rgba(255, 92, 108, 0.25);
  color: var(--shb-color-danger);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  line-height: 1;
  margin-left: 8rpx;
  transition: all 0.15s ease;
}

.member__kick--hover {
  background: rgba(255, 92, 108, 0.3);
  transform: scale(0.9);
}

/* 空位占位行（对齐设计图：序号 + 等待加入） */
.member--empty {
  padding: 22rpx 0;
  display: flex;
  align-items: center;
  gap: 28rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.03);
}

.member__slot-num {
  width: 56rpx;
  text-align: center;
  font-size: var(--shb-fs-md);
  color: var(--shb-text-tertiary);
  opacity: 0.6;
}

.member__empty-text {
  font-size: var(--shb-fs-sm);
  color: var(--shb-text-tertiary);
  letter-spacing: 1rpx;
}


.member--empty .num {
  font-weight: var(--shb-fw-medium);
}
