@import '../../styles/tokens.wxss';
@import '../../styles/common.wxss';

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding-bottom: 40rpx;
  background: var(--shb-bg-page);
}

.page-tail {
  height: 180rpx;
}

.pagehead {
  padding: 24rpx 36rpx 8rpx;
  font-size: 38rpx;
  font-weight: var(--shb-fw-bold);
  color: var(--shb-text-primary);
  text-align: center;
}

/* ---- 用户卡：圆形头像（青柠绿底深字） ---- */
.ucard {
  margin: 24rpx 36rpx 0;
  background: var(--shb-bg-card);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: var(--shb-radius-xl);
  padding: 36rpx 32rpx;
  display: flex;
  align-items: center;
  gap: 28rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.4);
}

.ucard__ava {
  width: 124rpx;
  height: 124rpx;
  border-radius: 50%;
  position: relative;
  flex-shrink: 0;
  border: 3rpx solid var(--shb-color-primary);
  box-shadow: 0 0 20rpx rgba(192, 232, 99, 0.35);
  overflow: visible;
}

.ucard__ava-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: #18222c;
}

.ucard__ava-dot {
  position: absolute;
  right: 2rpx;
  bottom: 2rpx;
  width: 22rpx;
  height: 22rpx;
  border-radius: 50%;
  background: var(--shb-color-primary);
  border: 4rpx solid var(--shb-bg-card);
  box-shadow: 0 0 8rpx var(--shb-color-primary);
}

.ucard__main {
  flex: 1;
  min-width: 0;
}

.ucard__name {
  font-size: var(--shb-fs-xl);
  font-weight: var(--shb-fw-bold);
  color: var(--shb-text-primary);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.ucard__sub {
  margin-top: 8rpx;
  font-size: var(--shb-fs-xs);
  color: var(--shb-text-tertiary);
}

.ucard__edit {
  flex-shrink: 0;
  font-size: var(--shb-fs-sm);
  color: var(--shb-text-inverse);
  background: var(--shb-color-primary);
  border-radius: var(--shb-radius-full);
  padding: 14rpx 32rpx;
  font-weight: var(--shb-fw-bold);
  letter-spacing: 1rpx;
  box-shadow: 0 4rpx 14rpx rgba(192, 232, 99, 0.3);
}

.ucard__edit--active {
  background: rgba(255, 255, 255, 0.08);
  color: var(--shb-text-secondary);
  box-shadow: none;
}

.ucard__edit--hover {
  opacity: 0.85;
}

/* ---- 昵称编辑面板 ---- */
.editpanel {
  margin: 24rpx 36rpx 0;
  background: var(--shb-bg-card);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: var(--shb-radius-xl);
  padding: 32rpx;
  box-shadow: 0 8rpx 28rpx rgba(0, 0, 0, 0.35);
}

.editpanel__input {
  background: var(--shb-bg-elev);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}

.editpanel__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
}

.editpanel__count {
  font-size: var(--shb-fs-xs);
  color: var(--shb-text-tertiary);
}

.editpanel__count--full {
  color: var(--shb-color-danger);
}

.editpanel__save {
  height: 76rpx;
  padding: 0 44rpx;
  font-size: var(--shb-fs-base);
  box-shadow: 0 4rpx 14rpx rgba(192, 232, 99, 0.3);
}

/* ---- 设置分组 ---- */
.setgroup {
  margin: 28rpx 36rpx 0;
  background: var(--shb-bg-card);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: var(--shb-radius-xl);
  padding: 8rpx 32rpx;
  box-shadow: 0 8rpx 28rpx rgba(0, 0, 0, 0.35);
}

.setrow {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
}

.setrow:last-child {
  border-bottom: none;
}

.setrow--hover {
  opacity: 0.75;
}

.setrow__left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.setrow__icon {
  font-size: 32rpx;
}

.setrow__label {
  font-size: var(--shb-fs-base);
  color: #ffffff;
  font-weight: var(--shb-fw-medium);
}

.setrow__val {
  font-size: var(--shb-fs-sm);
  color: var(--shb-text-secondary);
}

.setrow__arrow {
  font-size: 36rpx;
  color: var(--shb-text-tertiary);
}
