@import '../../styles/tokens.wxss';
@import '../../styles/common.wxss';

/* ============================================================
 * room-detail（参考图样式 · 单屏作战室）
 * ============================================================ */

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding-bottom: 40rpx;
  background: var(--shb-bg-page);
}

.page--loading {
  display: flex;
  align-items: center;
  justify-content: center;
}

.page-tail {
  height: 200rpx;
}

.pagehead {
  padding: 16rpx 36rpx 8rpx;
  font-size: var(--shb-fs-xxl);
  font-weight: var(--shb-fw-bold);
  color: var(--shb-text-primary);
}

/* ---- 房间档案卡 ---- */
.dossier {
  margin: 24rpx 36rpx 0;
  background: var(--shb-bg-card);
  border-radius: var(--shb-radius-lg);
  padding: 32rpx;
  display: flex;
  gap: 28rpx;
}

.dossier__cover {
  width: 168rpx;
  height: 168rpx;
  border-radius: var(--shb-radius-md);
  overflow: hidden;
  flex-shrink: 0;
}

.dossier__main {
  flex: 1;
  min-width: 0;
}

.dossier__title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.dossier__title {
  font-size: var(--shb-fs-xl);
  font-weight: var(--shb-fw-bold);
  color: var(--shb-text-primary);
}

.dossier__mode {
  font-size: var(--shb-fs-base);
  font-weight: var(--shb-fw-medium);
  color: var(--shb-text-secondary);
}

.dossier__meta {
  margin-top: 10rpx;
  font-size: var(--shb-fs-sm);
  color: var(--shb-text-secondary);
}

.dossier__meta-strong {
  color: #d7dee6;
  font-weight: var(--shb-fw-medium);
}

.dossier__remark {
  margin-top: 8rpx;
  font-size: var(--shb-fs-sm);
  color: var(--shb-text-secondary);
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

/* 满员进度条 */
.dossier__progress {
  margin-top: 24rpx;
  height: 12rpx;
  border-radius: var(--shb-radius-full);
  background: var(--shb-bg-track);
  overflow: hidden;
}

.dossier__fill {
  height: 100%;
  border-radius: var(--shb-radius-full);
  background: var(--shb-color-primary);
}

.dossier__prow {
  display: flex;
  justify-content: space-between;
  margin-top: 12rpx;
  font-size: var(--shb-fs-xs);
  color: var(--shb-text-secondary);
}

.dossier__pready {
  color: var(--shb-color-primary);
}

.dossier__pready .num {
  font-weight: var(--shb-fw-bold);
}

/* ---- 邀请码行：点击整行复制 ---- */
.dossier__code {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 20rpx;
  padding: 12rpx 20rpx;
  border-radius: var(--shb-radius-sm);
  background: var(--shb-bg-chip);
}

.dossier__code--hover {
  opacity: 0.75;
}

.dossier__code-label {
  font-size: var(--shb-fs-xs);
  color: var(--shb-text-tertiary);
}

.dossier__code-val {
  font-size: var(--shb-fs-lg);
  font-weight: var(--shb-fw-bold);
  letter-spacing: 4rpx;
  color: var(--shb-color-primary);
}

.dossier__code-copy {
  margin-left: auto;
  font-size: var(--shb-fs-xs);
  color: var(--shb-text-secondary);
}

/* ---- pending 提示条（琥珀） ---- */
.notice {
  margin: 24rpx 36rpx 0;
  background: var(--shb-color-pending-soft);
  border: 2rpx solid rgba(255, 178, 36, 0.4);
  border-radius: var(--shb-radius-md);
  padding: 20rpx 28rpx;
  font-size: var(--shb-fs-base);
  color: var(--shb-color-pending);
  font-weight: var(--shb-fw-medium);
}

/* ---- 准备板 ---- */
.board {
  margin: 24rpx 36rpx 0;
  background: var(--shb-bg-card);
  border-radius: var(--shb-radius-lg);
  padding: 8rpx 32rpx 16rpx;
}

.board__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0 12rpx;
}

.board__count {
  font-size: var(--shb-fs-xs);
  color: var(--shb-text-secondary);
}

.board__ready {
  color: var(--shb-color-primary);
  font-size: var(--shb-fs-sm);
}

/* ---- 聊天 ---- */
.chat {
  margin: 24rpx 36rpx 0;
  background: var(--shb-bg-card);
  border-radius: var(--shb-radius-lg);
  overflow: hidden;
}

.chat__list {
  height: 480rpx;
  padding: 28rpx 28rpx 32rpx;
  box-sizing: border-box;
}

.chat__empty {
  padding: 100rpx 0;
  text-align: center;
  font-size: var(--shb-fs-sm);
  color: var(--shb-text-tertiary);
}

.chat__item {
  margin-bottom: 24rpx;
}

.chat__bar {
  display: flex;
  gap: 16rpx;
  padding: 20rpx 24rpx 24rpx;
  border-top: 2rpx solid var(--shb-hairline);
}

.chat__input {
  flex: 1;
  min-width: 0;
  height: 76rpx;
  padding: 0 28rpx;
  background: var(--shb-bg-elev);
  border: none;
  border-radius: var(--shb-radius-full);
  font-size: var(--shb-fs-base);
  color: var(--shb-text-primary);
  box-sizing: border-box;
}

.chat__send {
  width: 136rpx;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--shb-color-primary);
  color: var(--shb-text-inverse);
  font-size: var(--shb-fs-sm);
  border-radius: var(--shb-radius-full);
}

.chat__send--hover {
  opacity: 0.85;
}

.chat__send--disabled {
  background: var(--shb-bg-elev);
  color: var(--shb-text-tertiary);
}

/* ---- 危险操作 ---- */
.danger-zone {
  padding: 36rpx 36rpx 8rpx;
}

/* 危险按钮占满整行，底部固定操作栏之上醒目可见 */
.danger-zone__btn {
  width: 100%;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--shb-fs-base);
  border-radius: var(--shb-radius-md);
  box-sizing: border-box;
}

.danger-link--hover {
  opacity: 0.6;
}

/* ---- 底部固定操作栏 ---- */
.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 20rpx;
  padding: 20rpx 28rpx;
  background: var(--shb-bg-card);
  border-top: 2rpx solid var(--shb-hairline);
  box-sizing: border-box;
}

.action-bar__btn {
  flex: 1;
  height: 96rpx;
}

.action-bar__btn--invite {
  flex: 0 0 152rpx;
}
