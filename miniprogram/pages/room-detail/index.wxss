@import '../../styles/tokens.wxss';
@import '../../styles/common.wxss';

/* ============================================================
 * room-detail（参考图样式 · 单屏作战室）
 * ============================================================ */

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding-bottom: 40rpx;
  background: var(--shb-bg-page);
}

.page--loading {
  display: flex;
  align-items: center;
  justify-content: center;
}

.page-tail {
  height: 200rpx;
}

.pagehead {
  padding: 16rpx 36rpx 8rpx;
  font-size: var(--shb-fs-xxl);
  font-weight: var(--shb-fw-bold);
  color: var(--shb-text-primary);
}

.pagehead--flex {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.quick-danger-btn {
  font-size: var(--shb-fs-sm);
  color: #ff5252;
  background: rgba(255, 82, 82, 0.14);
  border: 1rpx solid rgba(255, 82, 82, 0.4);
  border-radius: var(--shb-radius-full);
  padding: 10rpx 28rpx;
  font-weight: var(--shb-fw-bold);
  letter-spacing: 1rpx;
  box-shadow: 0 4rpx 16rpx rgba(255, 82, 82, 0.2);
}

.quick-danger-btn--hover {
  background: rgba(255, 82, 82, 0.28);
  border-color: #ff5252;
}

/* ---- 房间档案卡 ---- */
.dossier {
  margin: 24rpx 36rpx 0;
  background: var(--shb-bg-card);
  border-radius: var(--shb-radius-lg);
  padding: 32rpx;
  display: flex;
  gap: 28rpx;
}

.dossier__cover {
  width: 168rpx;
  height: 168rpx;
  border-radius: var(--shb-radius-md);
  overflow: hidden;
  flex-shrink: 0;
}

.dossier__main {
  flex: 1;
  min-width: 0;
}

.dossier__title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.dossier__title {
  font-size: var(--shb-fs-xl);
  font-weight: var(--shb-fw-bold);
  color: var(--shb-text-primary);
}

.dossier__mode {
  font-size: var(--shb-fs-base);
  font-weight: var(--shb-fw-medium);
  color: var(--shb-text-secondary);
}

.dossier__meta {
  margin-top: 10rpx;
  font-size: var(--shb-fs-sm);
  color: var(--shb-text-secondary);
}

.dossier__meta-strong {
  color: #d7dee6;
  font-weight: var(--shb-fw-medium);
}

.dossier__remark {
  margin-top: 8rpx;
  font-size: var(--shb-fs-sm);
  color: var(--shb-text-secondary);
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

/* 满员进度条 */
.dossier__progress {
  margin-top: 24rpx;
  height: 12rpx;
  border-radius: var(--shb-radius-full);
  background: var(--shb-bg-track);
  overflow: hidden;
}

.dossier__fill {
  height: 100%;
  border-radius: var(--shb-radius-full);
  background: var(--shb-color-primary);
}

.dossier__prow {
  display: flex;
  justify-content: space-between;
  margin-top: 12rpx;
  font-size: var(--shb-fs-xs);
  color: var(--shb-text-secondary);
}

.dossier__pready {
  color: var(--shb-color-primary);
}

.dossier__pready .num {
  font-weight: var(--shb-fw-bold);
}

/* ---- 邀请码行：点击整行复制 ---- */
.dossier__code {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 20rpx;
  padding: 12rpx 20rpx;
  border-radius: var(--shb-radius-sm);
  background: var(--shb-bg-chip);
}

.dossier__code--hover {
  opacity: 0.75;
}

.dossier__code-label {
  font-size: var(--shb-fs-xs);
  color: var(--shb-text-tertiary);
}

.dossier__code-val {
  font-size: var(--shb-fs-lg);
  font-weight: var(--shb-fw-bold);
  letter-spacing: 4rpx;
  color: var(--shb-color-primary);
}

.dossier__code-copy {
  margin-left: auto;
  font-size: var(--shb-fs-xs);
  color: var(--shb-text-secondary);
}

/* ---- pending 提示条（琥珀） ---- */
.notice {
  margin: 24rpx 36rpx 0;
  background: var(--shb-color-pending-soft);
  border: 2rpx solid rgba(255, 178, 36, 0.4);
  border-radius: var(--shb-radius-md);
  padding: 20rpx 28rpx;
  font-size: var(--shb-fs-base);
  color: var(--shb-color-pending);
  font-weight: var(--shb-fw-medium);
}

/* ---- 准备板 ---- */
.board {
  margin: 24rpx 36rpx 0;
  background: var(--shb-bg-card);
  border-radius: var(--shb-radius-lg);
  padding: 8rpx 32rpx 16rpx;
}

.board__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0 12rpx;
}

.board__count {
  font-size: var(--shb-fs-xs);
  color: var(--shb-text-secondary);
}

/* ---- 核心作战室 Tab 切换栏 ---- */
.room-tabs {
  margin: 24rpx 36rpx 0;
  background: var(--shb-bg-page);
}

.tab-panel {
  animation: panelFadeIn 0.2s ease-out;
}

@keyframes panelFadeIn {
  from { opacity: 0; transform: translateY(8rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* ---- 准备板 ---- */
.board {
  margin: 20rpx 36rpx 0;
  background: var(--shb-bg-card);
  border-radius: var(--shb-radius-xl);
  padding: 28rpx 32rpx;
  box-shadow: 0 8rpx 28rpx rgba(0, 0, 0, 0.35);
}

.board__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.08);
}

.board__count {
  font-size: var(--shb-fs-xs);
  color: var(--shb-text-tertiary);
  font-weight: var(--shb-fw-medium);
}

.board__ready {
  color: var(--shb-color-primary);
  font-size: var(--shb-fs-sm);
  font-weight: var(--shb-fw-bold);
}

/* ---- 聊天 ---- */
.chat {
  margin: 20rpx 36rpx 0;
  background: var(--shb-bg-card);
  border-radius: var(--shb-radius-xl);
  overflow: hidden;
  box-shadow: 0 8rpx 28rpx rgba(0, 0, 0, 0.35);
}

.chat__list {
  height: 600rpx;
  padding: 28rpx 28rpx 32rpx;
  box-sizing: border-box;
}

.chat__empty {
  padding: 140rpx 0;
  text-align: center;
  font-size: var(--shb-fs-sm);
  color: var(--shb-text-tertiary);
}

.chat__item {
  margin-bottom: 24rpx;
}

.chat__bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  background: rgba(13, 21, 29, 0.95);
  border-top: 1rpx solid rgba(255, 255, 255, 0.08);
}

.chat__input {
  flex: 1;
  min-width: 0;
  height: 76rpx;
  padding: 0 28rpx;
  background: var(--shb-bg-elev);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: var(--shb-radius-full);
  font-size: var(--shb-fs-base);
  color: var(--shb-text-primary);
  box-sizing: border-box;
}

.chat__send {
  width: 140rpx;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--shb-color-primary);
  color: var(--shb-text-inverse);
  font-size: var(--shb-fs-sm);
  font-weight: var(--shb-fw-bold);
  border-radius: var(--shb-radius-full);
  box-shadow: 0 4rpx 14rpx rgba(192, 232, 99, 0.3);
}

.chat__send--hover {
  background: var(--shb-color-primary-pressed);
}

.chat__send--disabled {
  background: var(--shb-bg-elev);
  color: var(--shb-text-tertiary);
  box-shadow: none;
}

/* ---- 设置卡片 ---- */
.setcard {
  margin: 20rpx 36rpx 0;
  background: var(--shb-bg-card);
  border-radius: var(--shb-radius-xl);
  padding: 32rpx;
  box-shadow: 0 8rpx 28rpx rgba(0, 0, 0, 0.35);
}

.setcard__title {
  font-size: var(--shb-fs-lg);
  font-weight: var(--shb-fw-bold);
  color: #ffffff;
  margin-bottom: 24rpx;
}

.setcard__row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
  font-size: var(--shb-fs-base);
}

.setcard__label {
  color: var(--shb-text-secondary);
}

.setcard__val {
  color: #ffffff;
  font-weight: var(--shb-fw-medium);
}

.text-primary {
  color: var(--shb-color-primary) !important;
}

/* ---- 危险操作 ---- */
.danger-zone {
  padding: 32rpx 36rpx 8rpx;
}

.danger-zone__btn {
  width: 100%;
  height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--shb-fs-base);
  border-radius: var(--shb-radius-md);
  box-sizing: border-box;
}

/* ---- 底部固定操作栏 ---- */
.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  gap: 20rpx;
  padding: 20rpx 28rpx;
  background: rgba(13, 21, 29, 0.95);
  border-top: 1rpx solid rgba(255, 255, 255, 0.1);
  box-shadow: 0 -8rpx 32rpx rgba(0, 0, 0, 0.6);
  backdrop-filter: blur(12px);
  box-sizing: border-box;
}

.action-bar__btn {
  flex: 1;
  height: 96rpx;
  font-size: var(--shb-fs-lg);
  font-weight: var(--shb-fw-bold);
  box-shadow: 0 4rpx 16rpx rgba(192, 232, 99, 0.3);
}

.action-bar__btn--invite {
  flex: 0 0 176rpx;
  box-shadow: none;
  font-size: var(--shb-fs-base);
}

