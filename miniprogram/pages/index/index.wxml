<!-- ============================================================
  招募大厅（参考图样式）
  页眉大标题 + 铃铛 → 胶囊筛选 chips → 我的房间 → 正在召集
============================================================ -->
<view class="page">

  <!-- 页眉：大标题 + 铃铛 -->
  <view class="apphead">
    <text class="apphead__title">招募大厅</text>
    <view class="bell" hover-class="bell--hover" bindtap="onBellTap">
      <view class="bell__body"></view>
      <view class="bell__dot"></view>
    </view>
  </view>

  <!-- 游戏分类筛选分段器（白粗体高亮 + 青柠绿下划线滑动小条，对齐设计图） -->
  <view class="tabs-bar">
    <segmented-tabs
      tabs="{{gameTabs}}"
      current="{{activeGameIndex}}"
      scrollable="{{true}}"
      bind:change="onGameTabTap"
    />
  </view>

  <!-- 邀请码战术直达：口述转告的 4 位码，融入暗色电竞 HUD 风格 -->
  <view class="invite-card">
    <view class="invite-card__badge">
      <text class="invite-card__icon">⚡</text>
    </view>
    <input
      class="invite-card__input"
      placeholder="输入邀请码 直达房间"
      placeholder-class="invite-card__placeholder"
      maxlength="8"
      confirm-type="go"
      value="{{inviteCode}}"
      bindinput="onInviteInput"
      bindconfirm="onJoinByCode"
    />
    <view
      class="invite-card__btn press-scale"
      hover-class="invite-card__btn--hover"
      bindtap="onJoinByCode"
    >进房<text class="invite-card__arrow">→</text></view>
  </view>

  <!-- 我的房间（仅在有数据时出现） -->
  <block wx:if="{{filteredMyRooms.length}}">
    <view class="sec">
      <view class="sec-title">我的房间</view>
      <text class="sec__count num">{{filteredMyRooms.length}} 个</text>
    </view>
    <view class="rooms">
      <room-card
        wx:for="{{filteredMyRooms}}"
        wx:key="_id"
        roomId="{{item._id}}"
        game="{{item.game}}"
        mode="{{item.mode}}"
        startTimeLabel="{{item.startTimeLabel}}"
        memberCount="{{item.memberCount || 0}}"
        maxPlayers="{{item.maxPlayers}}"
        status="{{item.status}}"
        remark="{{item.remark}}"
        roleText="{{item.roleText}}"
        isMine="{{true}}"
        bind:tap="onRoomTap"
      />
    </view>
  </block>

  <!-- 正在召集 -->
  <view class="sec">
    <view class="sec-title">正在召集 · {{gameTabs[activeGameIndex] || '全部'}}</view>
    <text class="sec__count num">{{filteredRooms.length}} 个房间</text>
  </view>

  <view wx:if="{{filteredRooms.length}}" class="rooms">
    <room-card
      wx:for="{{filteredRooms}}"
      wx:key="_id"
      roomId="{{item._id}}"
      game="{{item.game}}"
      mode="{{item.mode}}"
      startTimeLabel="{{item.startTimeLabel}}"
      memberCount="{{item.memberCount || 0}}"
      maxPlayers="{{item.maxPlayers}}"
      status="{{item.status}}"
      remark="{{item.remark}}"
      bind:tap="onRoomTap"
    />
  </view>
  <empty-state
    wx:else
    title="{{activeGameIndex > 0 ? '暂无【' + gameTabs[activeGameIndex] + '】招募房间' : '现在没有人在召集'}}"
    description="{{activeGameIndex > 0 ? '还没有这个游戏的房间，快去发起第一车！' : '发起一个房间，把链接甩进群里'}}"
    buttonText="{{activeGameIndex > 0 ? '发起【' + gameTabs[activeGameIndex] + '】' : '发起上号'}}"
    bind:action="goCreate"
  />

  <!-- 底部留白（自定义 TabBar 让位） -->
  <view class="page-tail"></view>
</view>
