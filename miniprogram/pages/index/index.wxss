@import '../../styles/tokens.wxss';
@import '../../styles/common.wxss';

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding-bottom: 40rpx;
  background: var(--shb-bg-page);
}

/* 底部留白：为自定义 TabBar（含凸起按钮）让位 */
.page-tail {
  height: 200rpx;
}

/* ---- 页眉：大标题 + 铃铛 ---- */
.apphead {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 36rpx 0;
}

.apphead__title {
  font-size: var(--shb-fs-xxl);
  font-weight: var(--shb-fw-bold);
  letter-spacing: 2rpx;
  color: var(--shb-text-primary);
}

/* 铃铛：深色圆底 + 线性铃身 + 青柠绿角标点 */
.bell {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  background: var(--shb-bg-card);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.bell--hover {
  opacity: 0.75;
}

.bell__body {
  width: 26rpx;
  height: 26rpx;
  border: 4rpx solid #aab4c0;
  border-bottom: none;
  border-radius: 14rpx 14rpx 4rpx 4rpx;
  position: relative;
  box-sizing: border-box;
}

.bell__body::before {
  content: '';
  position: absolute;
  left: 4rpx;
  top: 22rpx;
  width: 10rpx;
  height: 4rpx;
  background: #aab4c0;
  border-radius: var(--shb-radius-sm);
}

.bell__body::after {
  content: '';
  position: absolute;
  left: 7rpx;
  top: 28rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #aab4c0;
}

.bell__dot {
  position: absolute;
  top: 10rpx;
  right: 12rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--shb-color-primary);
  border: 4rpx solid var(--shb-bg-card);
  box-sizing: content-box;
}

/* ---- 筛选分段器 ---- */
.tabs-bar {
  margin-top: 16rpx;
  background: var(--shb-bg-page);
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
}

/* ---- 战术邀请码直达卡片（电竞 HUD 质感） ---- */
.invite-card {
  position: relative;
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 28rpx 36rpx 16rpx;
  padding: 12rpx 12rpx 12rpx 20rpx;
  background: var(--shb-bg-card);
  border: 1rpx solid var(--shb-hairline);
  border-radius: var(--shb-radius-full);
  box-shadow: var(--shb-shadow-card);
  overflow: hidden;
}

/* 顶部一道极细的主色高光，模拟 HUD 扫描线质感 */
.invite-card::before {
  content: '';
  position: absolute;
  left: 40rpx;
  right: 40rpx;
  top: 0;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, var(--shb-color-primary-soft), transparent);
}

/* 主色软底圆形徽章托住闪电图标，呼应页眉铃铛的处理 */
.invite-card__badge {
  width: 56rpx;
  height: 56rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--shb-color-primary-soft);
  border: 1rpx solid var(--shb-hairline);
}

.invite-card__icon {
  font-size: 26rpx;
  color: var(--shb-color-primary);
}

.invite-card__input {
  flex: 1;
  min-width: 0;
  height: 68rpx;
  /* 微信原生 input 未显式设 background 时会默认白底，配合白色文字 → 白底白字看不见
     （value 仍正确，故能进房）。显式透明底，露出卡片深色背景，白字可见。 */
  background: transparent;
  font-size: var(--shb-fs-md);
  font-weight: var(--shb-fw-medium);
  letter-spacing: 2rpx;
  color: var(--shb-text-primary);
}

.invite-card__placeholder {
  color: var(--shb-text-tertiary);
  font-size: var(--shb-fs-md);
  font-weight: var(--shb-fw-regular);
  letter-spacing: 0;
}

.invite-card__btn {
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 0 32rpx;
  border-radius: var(--shb-radius-full);
  background: var(--shb-color-primary);
  color: var(--shb-text-inverse);
  font-size: var(--shb-fs-md);
  font-weight: var(--shb-fw-bold);
  letter-spacing: 2rpx;
  box-shadow: var(--shb-shadow-glow);
  flex-shrink: 0;
}

.invite-card__arrow {
  font-size: var(--shb-fs-md);
  font-weight: var(--shb-fw-bold);
  margin-left: 2rpx;
}

.invite-card__btn--hover {
  background: var(--shb-color-primary-pressed);
  transform: scale(0.96);
}

/* ---- 分区头 ---- */
.sec {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 36rpx 36rpx 20rpx;
}

.sec__count {
  font-size: var(--shb-fs-xs);
  color: var(--shb-text-tertiary);
  font-weight: var(--shb-fw-medium);
  background: rgba(255, 255, 255, 0.04);
  padding: 4rpx 14rpx;
  border-radius: var(--shb-radius-full);
}

/* ---- 房间卡片列表 ---- */
.rooms {
  display: flex;
  flex-direction: column;
  padding: 0 36rpx;
}

