<!-- ============================================================
  发起上号（参考图样式 · 单页表单）
  游戏封面 2 列网格 → 人数步进+快捷档 → 模式 chips → 时间 chips → 备注
  底部：发起上号主按钮（随内容滚动）
============================================================ -->
<view class="page">

  <view class="pagehead">发起上号</view>

  <!-- 步骤向导指示条（对齐设计原型图） -->
  <view class="steps-bar">
    <view class="step-item step-item--active">
      <view class="step-item__dot">✓</view>
      <text class="step-item__label">选游戏</text>
    </view>
    <view class="step-line step-line--active"></view>
    <view class="step-item step-item--active">
      <view class="step-item__dot">2</view>
      <text class="step-item__label">设置</text>
    </view>
    <view class="step-line"></view>
    <view class="step-item">
      <view class="step-item__dot">3</view>
      <text class="step-item__label">备注</text>
    </view>
  </view>

  <!-- 游戏选择：2 列封面网格 -->
  <view class="formcard esports-card">
    <view class="formcard__head">
      <text class="formcard__title">选择游戏</text>
      <text class="formcard__hint">切换时带入默认人数</text>
    </view>
    <view class="ggrid">
      <view
        wx:for="{{games}}"
        wx:key="name"
        class="gitem {{gameIndex === index ? 'gitem--active' : ''}}"
        data-index="{{index}}"
        hover-class="gitem--hover"
        bindtap="onGameTap"
      >
        <view class="gitem__cover">
          <game-cover game="{{item.name}}" />
        </view>
        <view class="gitem__row">
          <text class="gitem__name">{{item.name}}</text>
          <text class="gitem__def num">{{item.defaultPlayers}}人</text>
        </view>
        <view wx:if="{{gameIndex === index}}" class="gitem__check">✓</view>
      </view>
      <!-- 自定义游戏入口：网格内显眼的「＋ 其他游戏」格子 -->
      <view
        class="gitem gitem--custom {{gameIndex === -1 ? 'gitem--active' : ''}}"
        hover-class="gitem--hover"
        bindtap="onCustomTileTap"
      >
        <view class="gitem__cover gitem__cover--plus">
          <text class="gitem__plus">＋</text>
        </view>
        <view class="gitem__row">
          <text class="gitem__name">其他游戏</text>
          <text class="gitem__def">自填</text>
        </view>
        <view wx:if="{{gameIndex === -1}}" class="gitem__check">✓</view>
      </view>
    </view>
    <!-- 自定义游戏名输入（点「其他游戏」格子后聚焦） -->
    <view class="formcard__input">
      <input
        class="sunk-input"
        placeholder="输入游戏名，如：我的世界 / 云顶之弈"
        placeholder-class="sunk-placeholder"
        maxlength="20"
        focus="{{focusCustomGame}}"
        value="{{customGame}}"
        bindinput="onCustomGameInput"
        bindblur="onCustomGameBlur"
      />
    </view>
  </view>

  <!-- 队伍人数：滑块调整（±微调 + 点刻度带直接设值） -->
  <view class="formcard esports-card">
    <view class="formcard__head">
      <text class="formcard__title">队伍人数</text>
      <text class="formcard__hint">2 – 20 人</text>
    </view>
    <view class="stepper">
      <view class="stepper__btn press-scale" hover-class="stepper__btn--hover" bindtap="decrease">−</view>
      <view
        class="pslider"
        catchtouchstart="onSliderTouchStart"
        catchtouchmove="onSliderTouchMove"
        catchtouchend="onSliderTouchEnd"
      >
        <view class="pslider__rail">
          <view class="pslider__fill" style="width: {{sliderPct}}%;"></view>
        </view>
        <!-- 滑块拖片：内嵌当前人数 -->
        <view class="pslider__thumb num" style="left: {{sliderPct}}%;">{{maxPlayers}}</view>
        <!-- 刻度停泊点层：19 个透明等分区，点哪个就是几人 -->
        <view class="pslider__stops">
          <view
            wx:for="{{sliderStops}}"
            wx:key="*this"
            class="pslider__stop"
            data-value="{{item}}"
            bindtap="onSliderTap"
          ></view>
        </view>
      </view>
      <view class="stepper__btn press-scale" hover-class="stepper__btn--hover" bindtap="increase">＋</view>
    </view>
    <view class="pslider__scale">
      <text class="num">2</text>
      <text class="num">10</text>
      <text class="num">20</text>
    </view>
  </view>

  <!-- 模式 / 地图 -->
  <view class="formcard esports-card">
    <view class="formcard__head">
      <text class="formcard__title">模式 / 地图</text>
      <text class="formcard__hint">30 字以内</text>
    </view>
    <view class="fchips">
      <view
        wx:for="{{modePresets}}"
        wx:key="*this"
        class="pill {{modePresetIndex === index ? 'pill--active' : ''}}"
        data-index="{{index}}"
        hover-class="pill--hover"
        bindtap="onModeChipTap"
      >{{item === '自定义' ? '自定义…' : item}}</view>
    </view>
    <view wx:if="{{modePresetIndex === modePresets.length - 1}}" class="formcard__input">
      <input
        class="sunk-input"
        placeholder="自定义模式/地图，如 5v5 · 亚海悬城"
        placeholder-class="sunk-placeholder"
        maxlength="30"
        value="{{mode}}"
        bindinput="onModeInput"
      />
    </view>
  </view>

  <!-- 开打时间 -->
  <view class="formcard esports-card">
    <view class="formcard__head">
      <text class="formcard__title">开打时间</text>
    </view>
    <view class="fchips">
      <view
        wx:for="{{timeOptions}}"
        wx:key="*this"
        class="pill {{timeIndex === index ? 'pill--active' : ''}}"
        data-index="{{index}}"
        hover-class="pill--hover"
        bindtap="onTimeTap"
      >{{item === '自定义时间' ? '自定义…' : item}}</view>
    </view>
    <!-- 选「自定义」时露出自由输入（与模式自定义一致的交互） -->
    <view wx:if="{{timeIndex === timeOptions.length - 1}}" class="formcard__input">
      <input
        class="sunk-input"
        placeholder="填写时间，如：今晚十点 / 周六 20:30"
        placeholder-class="sunk-placeholder"
        maxlength="20"
        value="{{customTime}}"
        bindinput="onCustomTimeInput"
      />
    </view>
  </view>

  <!-- 备注 -->
  <view class="formcard esports-card">
    <view class="formcard__head">
      <text class="formcard__title">备注</text>
      <text class="formcard__hint">选填</text>
    </view>
    <textarea
      class="formcard__textarea"
      placeholder="补充说明，如：来听指挥的、段位不限"
      placeholder-class="sunk-placeholder"
      maxlength="100"
      value="{{remark}}"
      bindinput="onRemarkInput"
    />
    <view class="formcard__count num">{{remark.length}} / 100</view>
  </view>

  <!-- 发起按钮（随内容流动，参考图样式） -->
  <view class="submitbar">
    <button
      class="btn btn--primary submitbar__btn press-scale"
      hover-class="btn--primary-hover"
      disabled="{{submitting}}"
      bindtap="submit"
    >{{submitting ? '发起中…' : '发起上号'}}</button>
    <text class="submitbar__sum">{{selectedGameName || '选个游戏'}}{{mode ? ' · ' + mode : ''}} · {{maxPlayers}} 人房 · {{timeLabel}}</text>
  </view>

  <!-- 底部留白（自定义 TabBar 让位） -->
  <view class="page-tail"></view>
</view>
