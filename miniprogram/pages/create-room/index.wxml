<view class="container">
  <view class="page-title">发起上号</view>
  <view class="page-subtitle">建个房间，把朋友喊来一起玩</view>

  <view class="card form-card">
    <view class="form-item">
      <text class="label">游戏 <text class="required">*</text></text>
      <picker mode="selector" range="{{games}}" value="{{gameIndex}}" bindchange="onGameChange">
        <view class="picker-value">{{games[gameIndex]}} <text>›</text></view>
      </picker>
    </view>
    <view class="divider"></view>
    <view class="form-item">
      <text class="label">模式 / 地图</text>
      <input placeholder="例如：排位、竞技模式、匹配" maxlength="30" value="{{mode}}" bindinput="onModeInput" />
    </view>
    <view class="divider"></view>
    <view class="form-item">
      <text class="label">需要人数 <text class="required">*</text></text>
      <view class="stepper">
        <text class="step" bindtap="decrease">−</text>
        <text class="number">{{maxPlayers}} 人</text>
        <text class="step" bindtap="increase">＋</text>
      </view>
    </view>
    <view class="divider"></view>
    <view class="form-item">
      <text class="label">开打时间 <text class="required">*</text></text>
      <picker mode="selector" range="{{timeOptions}}" value="{{timeIndex}}" bindchange="onTimeChange">
        <view class="picker-value">{{timeOptions[timeIndex]}} <text>›</text></view>
      </picker>
    </view>
    <view class="divider"></view>
    <view class="form-item remark-item">
      <text class="label">备注</text>
      <textarea placeholder="有什么想说的？" maxlength="100" value="{{remark}}" bindinput="onRemarkInput" auto-height />
    </view>
  </view>

  <button class="primary-button" bindtap="submit" loading="{{submitting}}">发起召集</button>
  <view class="tip">房间 2 小时无活动后会自动解散</view>
</view>
