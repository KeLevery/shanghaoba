@import '../../styles/tokens.wxss';
@import '../../styles/common.wxss';

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding-bottom: 40rpx;
  background: var(--shb-bg-page);
}

.page-tail {
  height: 180rpx;
}

.pagehead {
  padding: 16rpx 36rpx 8rpx;
  font-size: var(--shb-fs-xxl);
  font-weight: var(--shb-fw-bold);
  color: var(--shb-text-primary);
}

/* ---- 表单卡 ---- */
.formcard {
  margin: 28rpx 36rpx 0;
  background: var(--shb-bg-card);
  border-radius: var(--shb-radius-lg);
  padding: 32rpx;
}

.formcard__head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.formcard__title {
  font-size: var(--shb-fs-sm);
  font-weight: var(--shb-fw-bold);
  color: #d7dee6;
}

.formcard__hint {
  font-size: var(--shb-fs-xs);
  color: var(--shb-text-tertiary);
}

/* ---- 游戏封面 2 列网格 ---- */
.ggrid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.gitem {
  border-radius: 28rpx;
  overflow: hidden;
  background: var(--shb-bg-elev);
  position: relative;
  border: 4rpx solid transparent;
  box-sizing: border-box;
}

.gitem--hover {
  opacity: 0.85;
}

.gitem--active {
  border-color: var(--shb-color-primary);
}

.gitem__cover {
  height: 184rpx;
}

.gitem__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx 20rpx;
}

.gitem__name {
  font-size: var(--shb-fs-sm);
  font-weight: var(--shb-fw-bold);
  color: var(--shb-text-primary);
}

.gitem__def {
  font-size: var(--shb-fs-xs);
  color: var(--shb-text-tertiary);
  font-weight: var(--shb-fw-medium);
}

/* 选中角标：青柠绿圆 + 深色对勾 */
.gitem__check {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: var(--shb-color-primary);
  color: var(--shb-text-inverse);
  font-size: var(--shb-fs-sm);
  font-weight: var(--shb-fw-bold);
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ---- 人数步进器 ---- */
.stepper {
  display: flex;
  align-items: center;
}

.stepper__btn {
  width: 88rpx;
  height: 88rpx;
  border-radius: var(--shb-radius-md);
  background: var(--shb-bg-elev);
  color: #d7dee6;
  font-size: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.stepper__btn--hover {
  opacity: 0.7;
}

.stepper__val {
  flex: 1;
  display: flex;
  align-items: baseline;
  justify-content: center;
}

.stepper__num {
  font-size: 44rpx;
  color: var(--shb-text-primary);
}

.stepper__unit {
  font-size: var(--shb-fs-sm);
  color: var(--shb-text-tertiary);
  margin-left: 8rpx;
}

/* 快捷人数档 */
.qnums {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.qnums__item {
  width: 76rpx;
  height: 60rpx;
  border-radius: var(--shb-radius-full);
  background: var(--shb-bg-elev);
  color: var(--shb-text-secondary);
  font-size: var(--shb-fs-sm);
  display: flex;
  align-items: center;
  justify-content: center;
}

.qnums__item--hover {
  opacity: 0.7;
}

.qnums__item--active {
  background: var(--shb-color-primary);
  color: var(--shb-text-inverse);
  font-weight: var(--shb-fw-bold);
}

/* chips 区 */
.fchips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.formcard__input {
  margin-top: 24rpx;
}

/* 备注 */
.formcard__textarea {
  width: 100%;
  min-height: 168rpx;
  padding: 20rpx 28rpx;
  box-sizing: border-box;
  background: var(--shb-bg-elev);
  border: none;
  border-radius: var(--shb-radius-md);
  font-size: var(--shb-fs-base);
  line-height: 1.6;
  color: var(--shb-text-primary);
}

.formcard__count {
  margin-top: 12rpx;
  text-align: right;
  font-size: var(--shb-fs-xs);
  color: var(--shb-text-tertiary);
  font-weight: var(--shb-fw-medium);
}

/* ---- 发起按钮 ---- */
.submitbar {
  margin: 36rpx 36rpx 0;
}

.submitbar__btn {
  width: 100%;
  height: 100rpx;
  font-size: var(--shb-fs-lg);
}

.submitbar__sum {
  display: block;
  text-align: center;
  margin-top: 16rpx;
  font-size: var(--shb-fs-xs);
  color: var(--shb-text-tertiary);
}
