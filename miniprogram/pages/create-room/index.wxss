@import '../../styles/tokens.wxss';
@import '../../styles/common.wxss';

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding-bottom: 40rpx;
  background: var(--shb-bg-page);
}

.page-tail {
  height: 180rpx;
}

.pagehead {
  padding: 16rpx 36rpx 4rpx;
  font-size: var(--shb-fs-xxl);
  font-weight: var(--shb-fw-bold);
  color: var(--shb-text-primary);
}

/* ---- 步骤向导指示条 ---- */
.steps-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx 48rpx 20rpx;
}

.step-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.step-item__dot {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
  border: 2rpx solid rgba(255, 255, 255, 0.2);
  color: var(--shb-text-tertiary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: var(--shb-fw-bold);
}

.step-item--active .step-item__dot {
  background: var(--shb-color-primary);
  border-color: var(--shb-color-primary);
  color: var(--shb-text-inverse);
  box-shadow: 0 0 16rpx rgba(192, 232, 99, 0.4);
}

.step-item__label {
  font-size: 20rpx;
  color: var(--shb-text-tertiary);
  font-weight: var(--shb-fw-medium);
}

.step-item--active .step-item__label {
  color: var(--shb-color-primary);
  font-weight: var(--shb-fw-bold);
}

.step-line {
  flex: 1;
  height: 2rpx;
  background: rgba(255, 255, 255, 0.1);
  margin: -24rpx 16rpx 0;
}

.step-line--active {
  background: var(--shb-color-primary);
  box-shadow: 0 0 8rpx var(--shb-color-primary);
}

/* ---- 表单卡 ---- */
.formcard {
  margin: 24rpx 36rpx 0;
  background: var(--shb-bg-card);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: var(--shb-radius-xl);
  padding: 32rpx;
  box-shadow: 0 8rpx 28rpx rgba(0, 0, 0, 0.35);
}

.formcard__head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.formcard__title {
  font-size: var(--shb-fs-sm);
  font-weight: var(--shb-fw-bold);
  color: #d7dee6;
}

.formcard__hint {
  font-size: var(--shb-fs-xs);
  color: var(--shb-text-tertiary);
}

/* ---- 游戏封面 2 列网格 ---- */
.ggrid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.gitem {
  border-radius: 28rpx;
  overflow: hidden;
  background: var(--shb-bg-elev);
  position: relative;
  border: 4rpx solid transparent;
  box-sizing: border-box;
  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
}

.gitem--hover {
  opacity: 0.88;
  transform: translateY(-2rpx);
}

.gitem--active {
  border-color: var(--shb-color-primary);
  box-shadow: 0 0 24rpx rgba(192, 232, 99, 0.35);
}

/* 「其他游戏」自填格子：虚线边框 + 居中大＋，与预设游戏格区分但同尺寸 */
.gitem--custom {
  border: 4rpx dashed var(--shb-hairline-strong);
  background: transparent;
}

.gitem__cover--plus {
  display: flex;
  align-items: center;
  justify-content: center;
}

.gitem__plus {
  font-size: 64rpx;
  font-weight: var(--shb-fw-bold);
  color: var(--shb-text-secondary);
}

.gitem--custom.gitem--active {
  border: 4rpx solid var(--shb-color-primary);
}

.gitem--custom .gitem__name {
  color: var(--shb-text-secondary);
}

.gitem--custom.gitem--active .gitem__name {
  color: var(--shb-text-primary);
}

.gitem__cover {
  height: 184rpx;
}

.gitem__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx 20rpx;
}

.gitem__name {
  font-size: var(--shb-fs-sm);
  font-weight: var(--shb-fw-bold);
  color: var(--shb-text-primary);
}

.gitem__def {
  font-size: var(--shb-fs-xs);
  color: var(--shb-text-tertiary);
  font-weight: var(--shb-fw-medium);
}

/* 选中角标：青柠绿圆 + 深色对勾 */
.gitem__check {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: var(--shb-color-primary);
  color: var(--shb-text-inverse);
  font-size: var(--shb-fs-sm);
  font-weight: var(--shb-fw-bold);
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ---- 人数滑块（轨道 + 青柠绿拖片 + 刻度停泊点层） ---- */
.stepper {
  display: flex;
  align-items: center;
}

.stepper__btn {
  width: 88rpx;
  height: 88rpx;
  flex-shrink: 0;
  border-radius: var(--shb-radius-md);
  background: var(--shb-bg-elev);
  color: #d7dee6;
  font-size: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.stepper__btn--hover {
  opacity: 0.7;
}

.pslider {
  position: relative;
  flex: 1;
  height: 88rpx;
  margin: 0 20rpx;
}

.pslider__rail {
  position: absolute;
  left: 0;
  right: 0;
  top: 50%;
  height: 12rpx;
  transform: translateY(-50%);
  border-radius: var(--shb-radius-full);
  background: var(--shb-bg-track);
  overflow: hidden;
}

.pslider__fill {
  height: 100%;
  border-radius: var(--shb-radius-full);
  background: var(--shb-color-primary);
}

/* 拖片：内嵌当前人数；pointer-events:none 让点击穿透到刻度层 */
.pslider__thumb {
  position: absolute;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  box-sizing: border-box;
  border: 4rpx solid #0d151d;
  background: var(--shb-color-primary);
  color: var(--shb-text-inverse);
  font-size: var(--shb-fs-sm);
  font-weight: var(--shb-fw-bold);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(192, 232, 99, 0.3);
  pointer-events: none;
}

/* 刻度停泊点层：透明等分区铺满轨道，点击即设值 */
.pslider__stops {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
}

.pslider__stop {
  flex: 1;
}

.pslider__scale {
  display: flex;
  justify-content: space-between;
  margin-top: 12rpx;
  font-size: var(--shb-fs-xs);
  color: var(--shb-text-tertiary);
}

/* chips 区 */
.fchips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.formcard__input {
  margin-top: 24rpx;
}

/* 备注 */
.formcard__textarea {
  width: 100%;
  min-height: 168rpx;
  padding: 20rpx 28rpx;
  box-sizing: border-box;
  background: var(--shb-bg-elev);
  border: none;
  border-radius: var(--shb-radius-md);
  font-size: var(--shb-fs-base);
  line-height: 1.6;
  color: var(--shb-text-primary);
}

.formcard__count {
  margin-top: 12rpx;
  text-align: right;
  font-size: var(--shb-fs-xs);
  color: var(--shb-text-tertiary);
  font-weight: var(--shb-fw-medium);
}

/* ---- 发起按钮 ---- */
.submitbar {
  margin: 36rpx 36rpx 0;
}

.submitbar__btn {
  width: 100%;
  height: 100rpx;
  font-size: var(--shb-fs-lg);
  box-shadow: 0 6rpx 24rpx rgba(192, 232, 99, 0.35);
}

.submitbar__sum {
  display: block;
  text-align: center;
  margin-top: 16rpx;
  font-size: var(--shb-fs-xs);
  color: var(--shb-text-tertiary);
}
