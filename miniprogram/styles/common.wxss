/* ============================================================
 * common.wxss — 通用工具类（参考图深色青柠绿风格）
 * 依赖 tokens.wxss，需在其后引入。
 * ============================================================ */

/* ---- 等宽计分数字 ---- */
.num {
  font-family: var(--shb-font-num);
  font-weight: var(--shb-fw-bold);
}

/* ---- 布局 ---- */
.flex { display: flex; }
.flex-col { display: flex; flex-direction: column; }
.flex-center { display: flex; align-items: center; justify-content: center; }
.flex-between { display: flex; align-items: center; justify-content: space-between; }
.flex-1 { flex: 1; min-width: 0; }
.flex-shrink-0 { flex-shrink: 0; }

/* ---- 文本截断 ---- */
.text-ellipsis {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* ---- 安全区适配（底部 Home Indicator） ---- */
.safe-area-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

/* ---- 分区标题（青柠绿短竖条 + 白粗体） ---- */
.sec-title {
  display: flex;
  align-items: center;
  gap: 14rpx;
  font-size: var(--shb-fs-lg);
  font-weight: var(--shb-fw-bold);
  color: var(--shb-text-primary);
}
.sec-title::before {
  content: '';
  width: 8rpx;
  height: 28rpx;
  border-radius: var(--shb-radius-sm);
  background: var(--shb-color-primary);
}

/* ---- 胶囊（筛选 chips / 表单选项，激活 = 青柠绿填充深字） ---- */
.pill {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  height: 64rpx;
  padding: 0 32rpx;
  border-radius: var(--shb-radius-full);
  background: var(--shb-bg-chip);
  color: var(--shb-text-secondary);
  font-size: var(--shb-fs-base);
}
.pill--active {
  background: var(--shb-color-primary);
  color: var(--shb-text-inverse);
  font-weight: var(--shb-fw-bold);
}
.pill--hover {
  opacity: 0.75;
}

/* ---- 凹槽输入 ---- */
.sunk-input {
  width: 100%;
  height: 84rpx;
  padding: 0 28rpx;
  box-sizing: border-box;
  background: var(--shb-bg-elev);
  border: none;
  border-radius: var(--shb-radius-md);
  font-size: var(--shb-fs-base);
  color: var(--shb-text-primary);
}
.sunk-placeholder {
  color: var(--shb-text-tertiary);
}

/* ---- 基础排版与重置 ---- */
::-webkit-scrollbar {
  display: none !important;
  width: 0 !important;
  height: 0 !important;
}

page {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  color: var(--shb-text-primary);
  background-color: var(--shb-bg-page);
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

/* ---- 按钮 ---- */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  font-size: var(--shb-fs-lg);
  font-weight: var(--shb-fw-bold);
  border-radius: var(--shb-radius-md);
  box-sizing: border-box;
}
.btn--primary {
  background: var(--shb-color-primary);
  color: var(--shb-text-inverse);
  letter-spacing: 2rpx;
}
.btn--primary-hover { background: var(--shb-color-primary-pressed); }
.btn--ghost {
  background: var(--shb-bg-card);
  border: 2rpx solid var(--shb-hairline-strong);
  color: #d7dee6;
}
.btn--ghost-hover { opacity: 0.75; }
.btn--outline-primary {
  background: transparent;
  border: 3rpx solid var(--shb-color-primary);
  color: var(--shb-color-primary);
}
.btn--danger-link {
  color: var(--shb-color-danger);
  font-size: var(--shb-fs-md);
  padding: 16rpx 24rpx;
}

/* 软红实感按钮：危险操作（退出/解散）用，比文字链接醒目 */
.btn--danger {
  background: var(--shb-color-danger-soft);
  border: 2rpx solid rgba(255, 92, 108, 0.4);
  color: var(--shb-color-danger);
  font-weight: var(--shb-fw-medium);
}
.btn--danger-hover {
  opacity: 0.8;
  background: rgba(255, 92, 108, 0.2);
}

/* ---- 状态点标签（圆点 + 文字） ---- */
.tagdot {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  font-size: var(--shb-fs-xs);
  color: var(--shb-color-primary);
}
.tagdot::before {
  content: '';
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--shb-color-primary);
}
.tagdot--pending { color: var(--shb-color-pending); }
.tagdot--pending::before { background: var(--shb-color-pending); }
.tagdot--gray { color: var(--shb-text-tertiary); }
.tagdot--gray::before { background: var(--shb-text-tertiary); }

/* ---- 触感按压缩放（微动效，提升跟手感） ---- */
.press-scale {
  transition: transform 0.15s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.15s ease;
}
.press-scale:active {
  transform: scale(0.97);
  opacity: 0.9;
}

/* ---- 电竞质感卡片基类（带微发光描边 + 柔和阴影） ---- */
.esports-card {
  background: var(--shb-bg-card);
  border: var(--shb-border-subtle);
  border-radius: var(--shb-radius-lg);
  box-shadow: var(--shb-shadow-card);
  transition: all 0.2s ease;
}

/* ---- 骨架屏流光扫光动效 ---- */
@keyframes shimmer {
  0% { background-position: -400rpx 0; }
  100% { background-position: 400rpx 0; }
}

.skeleton-shimmer {
  background: linear-gradient(
    90deg,
    rgba(255, 255, 255, 0.03) 25%,
    rgba(255, 255, 255, 0.08) 37%,
    rgba(255, 255, 255, 0.03) 63%
  );
  background-size: 800rpx 100%;
  animation: shimmer 1.6s infinite ease-in-out;
  border-radius: var(--shb-radius-md);
}

/* ---- 脉冲发光呼吸灯 ---- */
@keyframes pulseGlow {
  0%, 100% {
    box-shadow: 0 0 8rpx rgba(192, 232, 99, 0.2);
    transform: scale(1);
  }
  50% {
    box-shadow: 0 0 20rpx rgba(192, 232, 99, 0.6);
    transform: scale(1.05);
  }
}
.pulse-glow {
  animation: pulseGlow 2s infinite ease-in-out;
}

